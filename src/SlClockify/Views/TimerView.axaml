<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModels="clr-namespace:SlClockify.ViewModels"
             x:Class="SlClockify.Views.TimerView"
             x:DataType="viewModels:TimerViewModel">
    <!-- Laid out like Clockify's timer bar: what you work on on the left, the big action button on the right -->
    <Grid
        Margin="16"
        IsVisible="{Binding ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
            <!-- Idle: pick the project and task -->
            <AutoCompleteBox
                ItemsSource="{Binding ProjectChoices}"
                SelectedItem="{Binding SelectedChoice}"
                FilterMode="Custom"
                ItemFilter="{Binding ChoiceFilter}"
                MinimumPrefixLength="0"
                PlaceholderText="Project / task"
                IsVisible="{Binding !IsRunning}"
                HorizontalAlignment="Stretch">
                <AutoCompleteBox.InnerLeftContent>
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="8,0,0,0"
                        Fill="{Binding SelectedChoice.Brush}"
                        IsVisible="{Binding SelectedChoice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </AutoCompleteBox.InnerLeftContent>
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProjectTaskChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Project.Name}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Task.Name}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>

            <!-- Running: the project and task being timed, in the project's color -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Margin="4,0,0,0"
                IsVisible="{Binding IsRunning}">
                <Ellipse Width="8" Height="8" Fill="{Binding SelectedChoice.Brush}" VerticalAlignment="Center" />
                <TextBlock Foreground="{Binding SelectedChoice.Brush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding SelectedChoice.Project.Name}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedChoice.Task.Name}" />
                </TextBlock>
            </StackPanel>

            <TextBox
                Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                PlaceholderText="What are you working on?" />
        </StackPanel>

        <Button
            Grid.Column="1"
            Classes="accent"
            ToolTip.Tip="Start"
            Command="{Binding StartAsync}"
            IsVisible="{Binding !IsRunning}"
            IsEnabled="{Binding !IsBusy}"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <ui:FASymbolIcon Symbol="PlayFilled" FontSize="20" />
        </Button>
        <!-- Accent button with its brushes overridden to Clockify's red, so hover and pressed states keep working -->
        <Button
            Grid.Column="1"
            Classes="accent"
            ToolTip.Tip="Stop"
            Command="{Binding StopAsync}"
            IsVisible="{Binding IsRunning}"
            IsEnabled="{Binding !IsBusy}"
            FontSize="16"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <Button.Resources>
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#F44336" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E53935" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D32F2F" />
                <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="StopFilled" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
