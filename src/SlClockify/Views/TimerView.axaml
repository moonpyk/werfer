<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="clr-namespace:SlClockify.Converters"
             xmlns:viewModels="clr-namespace:SlClockify.ViewModels"
             x:Class="SlClockify.Views.TimerView"
             x:DataType="viewModels:TimerViewModel">
    <!-- Laid out like Clockify's timer bar: what you work on on the left, the big action button on the right.
         Disabled until connected and the projects are loaded -->
    <Grid
        Margin="8"
        IsEnabled="{Binding ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center">
            <!-- Project and task, also editable while the timer runs -->
            <AutoCompleteBox
                AsyncPopulator="{Binding ProjectChoicesPopulator}"
                SelectedItem="{Binding SelectedChoice}"
                FilterMode="None"
                MinimumPrefixLength="3"
                PlaceholderText="Project / Task"
                HorizontalAlignment="Stretch">
                <AutoCompleteBox.InnerLeftContent>
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="8,0,0,0"
                        Fill="{Binding SelectedChoice.Brush}"
                        IsVisible="{Binding SelectedChoice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </AutoCompleteBox.InnerLeftContent>
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProjectTaskChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{x:Static converters:ReadableTextBrushConverter.Instance}">
                                        <Binding Path="Color" />
                                        <Binding RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding Task.Name}" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>

            <TextBox
                Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                PlaceholderText="What are you working on?" />
        </StackPanel>

        <Button
            Grid.Column="1"
            ToolTip.Tip="Start (Ctrl+Enter)"
            Classes="accent"
            Command="{Binding StartAsync}"
            IsVisible="{Binding !IsRunning}"
            IsEnabled="{Binding !IsBusy}"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <ui:FASymbolIcon Symbol="PlayFilled" FontSize="20" />
        </Button>
        <!-- Accent button with its brushes overridden to Clockify's red, so hover and pressed states keep working -->
        <Button
            Grid.Column="1"
            ToolTip.Tip="Stop (Ctrl+Enter)"
            Classes="accent"
            Command="{Binding StopAsync}"
            IsVisible="{Binding IsRunning}"
            IsEnabled="{Binding !IsBusy}"
            FontSize="16"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <Button.Resources>
                <!-- ReSharper disable Xaml.RedundantResource -->
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#F44336" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E53935" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D32F2F" />
                <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
                <!-- ReSharper restore Xaml.RedundantResource -->
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="StopFilled" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
