<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SlClockify.ViewModels"
        x:Class="SlClockify.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="SlClockify"
        Width="420"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Clockify API key" />
        <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="Paste your API key" />
        <Button
            Content="Connect"
            Command="{Binding ConnectAsync}"
            IsEnabled="{Binding !IsBusy}"
            IsDefault="True" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Spacing="8" IsVisible="{Binding ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Project / task" />
            <AutoCompleteBox
                ItemsSource="{Binding ProjectChoices}"
                SelectedItem="{Binding SelectedChoice}"
                FilterMode="Custom"
                ItemFilter="{Binding ChoiceFilter}"
                MinimumPrefixLength="0"
                PlaceholderText="Type to search a project or a task"
                IsEnabled="{Binding !IsRunning}"
                HorizontalAlignment="Stretch">
                <AutoCompleteBox.InnerLeftContent>
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="8,0,0,0"
                        Fill="{Binding SelectedChoice.Brush}"
                        IsVisible="{Binding SelectedChoice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </AutoCompleteBox.InnerLeftContent>
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProjectTaskChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Project.Name}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Task.Name}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <TextBox
                Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                PlaceholderText="What are you working on?" />
            <TextBlock Text="{Binding Elapsed}" FontSize="32" HorizontalAlignment="Center" />
            <Button
                Content="Start"
                Command="{Binding StartAsync}"
                IsVisible="{Binding !IsRunning}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch" />
            <Button
                Content="Stop"
                Command="{Binding StopAsync}"
                IsVisible="{Binding IsRunning}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch" />
        </StackPanel>
    </StackPanel>
</Window>
