<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slClockify="clr-namespace:SlClockify"
        x:Class="SlClockify.MainWindow"
        x:DataType="slClockify:MainWindowViewModel"
        Title="SlClockify"
        Width="420"
        SizeToContent="Height">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Clockify API key" />
        <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="Paste your API key" />
        <Button
            Content="Connect"
            Command="{Binding ConnectAsync}"
            IsEnabled="{Binding !IsBusy}"
            IsDefault="True" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
</Window>
