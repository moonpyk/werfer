<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <IsPackable>false</IsPackable>
        <RootNamespace>Werfer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
        <PackageReference Include="Refit" Version="16.4.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>
</Project>
