<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\Werfer.ico</ApplicationIcon>
        <Version>0.3.0</Version>
        <IsPackable>false</IsPackable>
        <RootNamespace>Werfer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.5"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="FluentAvaloniaUI" Version="3.1.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.TraceSource" Version="10.0.14"/>
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14"/>
    </ItemGroup>

    <ItemGroup Condition="$(Configuration) == 'Debug'">
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Werfer.Core\Werfer.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\EditWindow.axaml.cs">
            <DependentUpon>TimeEntryEditWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

</Project>
