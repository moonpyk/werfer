<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:werfer="clr-namespace:Werfer;assembly=Werfer.Core"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="Werfer.Views.AboutView">
    <UserControl.Styles>
        <!-- Section titles, as in the settings page -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <!-- A key, drawn as a small key cap -->
        <Style Selector="Border.key">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.key TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Grid.shortcuts > TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="12,0,12,12" Spacing="8">
            <!-- Who and which version on the left, the colored logo top right: the icon's 256 px image, extracted from Werfer.ico, scaled down -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="section" Theme="{StaticResource SubtitleTextBlockStyle}" Text="Werfer" />
                    <TextBlock
                        FontSize="12"
                        Text="{x:Static werfer:Version.Display}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="Brought to you by Clément Bourgeois, with help from:"
                        TextWrapping="Wrap" />
                    <!-- 
                    Assets/Thanks.txt as written, hidden while it holds only comments, see AboutView.axaml.cs 
                    -->
                    <TextBlock
                        x:Name="ThanksText"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton
                        Padding="2"
                        NavigateUri="https://github.com/moonpyk/werfer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Open" />
                            <TextBlock Text="github.com/moonpyk/werfer" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <Image
                    Grid.Column="1"
                    Width="128"
                    Height="128"
                    Margin="0,16,0,0"
                    VerticalAlignment="Top"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="avares://Werfer/Assets/Werfer256.png" />
            </Grid>

            <TextBlock
                Classes="section"
                Text="Keyboard shortcuts" />
            <!-- Same shortcuts as the window's KeyBindings and the README: keep the three in step -->
            <Grid
                Classes="shortcuts"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="8">
                <Border Classes="key">
                    <TextBlock Text="Ctrl+Space" />
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Start the timer, or stop it when it runs" />

                <Border Grid.Column="0" Grid.Row="1" Classes="key">
                    <TextBlock Text="F5" />
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Fetch the running entry and the history from Clockify" />

                <Border Grid.Column="0" Grid.Row="2" Classes="key">
                    <TextBlock Text="Ctrl+L" />
                </Border>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Clear the description" />

                <Border Grid.Column="0" Grid.Row="3" Classes="key">
                    <TextBlock Text="Ctrl+N" />
                </Border>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="New blank entry: stop the timer, clear the description and the project" />

                <Border Grid.Column="0" Grid.Row="4" Classes="key">
                    <TextBlock Text="Ctrl+," />
                </Border>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Open the settings" />

                <Border Grid.Column="0" Grid.Row="5" Classes="key">
                    <TextBlock Text="Enter" />
                </Border>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="New line in the description; saves an edit or a split, applies a new start time" />

                <Border Grid.Column="0" Grid.Row="6" Classes="key">
                    <TextBlock Text="Escape" />
                </Border>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Close an edit or a split without saving" />
            </Grid>
            <TextBlock
                Classes="section"
                Text="Sponsor" />
            <Border 
                Background="#EEFFFFFF" 
                CornerRadius="{DynamicResource ControlCornerRadius}">
                <HyperlinkButton HorizontalAlignment="Center" NavigateUri="https://www.repply.fr">
                    <!-- A logo, not a text link: no background behind it on hover or press -->
                    <HyperlinkButton.Resources>
                        <!-- ReSharper disable Xaml.RedundantResource -->
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
                        <!-- ReSharper restore Xaml.RedundantResource -->
                    </HyperlinkButton.Resources>
                    <Image Margin="8" Source="avares://Werfer/Assets/repply_logo.png" Height="31" />
                </HyperlinkButton>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
