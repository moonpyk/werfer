<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:timer="clr-namespace:Werfer.Views.Timer"
             x:Class="Werfer.Views.TimerView"
             x:DataType="vm:TimerViewModel">
    <!--
    The timer bar on top, sized by its content (the description grows with its lines), the week's history takes the
    rest; both bind to this page's view model. Disabled until connected and the projects are loaded
    -->
    <Grid
        RowDefinitions="Auto,*"
        IsEnabled="{Binding ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
        <timer:TimerBarView Grid.Row="0" />
        <timer:HistoryView Grid.Row="1" />
    </Grid>
</UserControl>
