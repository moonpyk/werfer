<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:timer="clr-namespace:Werfer.Views.Timer"
             xmlns:edit="clr-namespace:Werfer.Views.Edit"
             xmlns:sheet="clr-namespace:Werfer.Controls.Sheet"
             x:Class="Werfer.Views.TimerView"
             x:DataType="vm:TimerViewModel">
    <Panel>
        <!--
        The timer bar on top, as tall as its content (the description grows with its lines); the week's history fills
        the rest. Disabled until connected and the projects are loaded
        -->
        <Grid
            RowDefinitions="Auto,*"
            IsEnabled="{Binding Player.ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
            <timer:TimerBarView Grid.Row="0" DataContext="{Binding Player}" />
            <timer:HistoryView Grid.Row="1" DataContext="{Binding History}" />
        </Grid>

        <!--
        Edit or split sheet, modal: the same buttons over each form's own view, picked by the DataTemplates. Escape closes
        it, see the window's KeyBindings
        -->
        <sheet:Sheet
            IsOpen="{Binding IsSheetOpen}"
            IsLightDismissEnabled="{Binding !IsSheetSaving}"
            Content="{Binding SheetContent}">
            <sheet:Sheet.DataTemplates>
                <DataTemplate DataType="vm:TimeEntryEditViewModel">
                    <edit:TimeEntryEditView />
                </DataTemplate>
                <DataTemplate DataType="vm:TimeEntrySplitViewModel">
                    <edit:TimeEntrySplitView />
                </DataTemplate>
            </sheet:Sheet.DataTemplates>
            <sheet:Sheet.ContentTemplate>
                <DataTemplate x:DataType="vm:SheetFormViewModel">
                    <!-- Enter saves, except in a multiline description, which takes it as a new line -->
                    <DockPanel>
                        <DockPanel.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </DockPanel.KeyBindings>
                        <!-- Same order as the delete dialog: Cancel left, Save right -->
                        <StackPanel
                            DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,16,0,0">
                            <Button
                                Content="Cancel"
                                MinWidth="96"
                                Command="{Binding CancelCommand}" />
                            <Button
                                Content="Save"
                                Classes="accent"
                                MinWidth="96"
                                Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <!-- The form itself, from the DataTemplates above -->
                        <ContentControl Content="{Binding}" />
                    </DockPanel>
                </DataTemplate>
            </sheet:Sheet.ContentTemplate>
        </sheet:Sheet>
    </Panel>
</UserControl>
