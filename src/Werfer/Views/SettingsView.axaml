<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Werfer.ViewModels"
             x:Class="Werfer.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Clockify API key" />
        <TextBox
            Text="{Binding ApiKey}"
            PasswordChar="•"
            PlaceholderText="Paste your API key" />
        <Button
            Content="Save and connect"
            Command="{Binding ConnectAsync}"
            IsEnabled="{Binding !IsBusy}"
            IsDefault="True" />
    </StackPanel>
</UserControl>
