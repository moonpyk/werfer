<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             x:Class="Werfer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Clockify API key" />
        <TextBox
            Text="{Binding ApiKey}"
            PasswordChar="•"
            PlaceholderText="Paste your API key" />
        <Button
            Content="Save and connect"
            Command="{Binding ConnectCommand}"
            IsEnabled="{Binding !IsBusy}"
            IsDefault="True" />

        <TextBlock Text="First day of the week" Margin="0,8,0,0" />
        <ComboBox
            ItemsSource="{Binding DaysOfWeek}"
            SelectedItem="{Binding WeekStart}"
            MinWidth="160" />
    </StackPanel>
</UserControl>
