<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:ctl="clr-namespace:Werfer.Controls"
             x:Class="Werfer.Views.Timer.TimerBarView"
             x:DataType="vm:TimerPlayerViewModel">
    <!-- Project, task and description on the left, the start/stop button on the right -->
    <Grid
        Margin="8"
        ColumnDefinitions="*,Auto">
        <Grid
            Grid.Column="0"
            RowDefinitions="Auto,Auto"
            RowSpacing="8"
            Margin="0,0,12,0">
            <!-- Project and task, also editable while the timer runs -->
            <ctl:ProjectTaskSelector
                Grid.Row="0"
                AsyncPopulator="{Binding ProjectChoicesPopulator}"
                SelectedItem="{Binding SelectedChoice}"
                Text="{Binding ProjectSearchText}" />

            <!--
            Enter adds a line. Line breaks are \n rather than Windows' \r\n, so the text compares equal to what Clockify
            sends back. Grows with its lines up to about 6, then scrolls, so the history below keeps its space. The text
            goes to the running entry when the box loses focus, see OnDescriptionLostFocus
            -->
            <TextBox
                Grid.Row="1"
                Text="{Binding Description}"
                LostFocus="OnDescriptionLostFocus"
                PastingFromClipboard="OnDescriptionPasting"
                PlaceholderText="What are you working on?"
                AcceptsReturn="True"
                NewLine="&#10;"
                TextWrapping="Wrap"
                MaxHeight="140"
                VerticalContentAlignment="Top" />
        </Grid>

        <Button
            Grid.Column="1"
            ToolTip.Tip="Start (Ctrl+Space)"
            Classes="accent"
            Command="{Binding StartCommand}"
            IsVisible="{Binding !IsRunning}"
            IsEnabled="{Binding !IsBusy}"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <ui:FASymbolIcon Symbol="PlayFilled" FontSize="20" />
        </Button>
        <!--
        Stops on the main part; the chevron opens the running entry's start time. Brushes overridden to red, so hover and
        pressed states keep working
        -->
        <SplitButton
            x:Name="StopButton"
            Grid.Column="1"
            ToolTip.Tip="Stop (Ctrl+Space)"
            Command="{Binding StopCommand}"
            IsVisible="{Binding IsRunning, FallbackValue=False}"
            IsEnabled="{Binding !IsBusy}"
            FontSize="16"
            MinWidth="120"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <SplitButton.Resources>
                <!-- ReSharper disable Xaml.RedundantResource -->
                <SolidColorBrush x:Key="SplitButtonBackground" Color="#F44336" />
                <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#E53935" />
                <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#D32F2F" />
                <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="White" />
                <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#B71C1C" />
                <!-- ReSharper restore Xaml.RedundantResource -->
            </SplitButton.Resources>
            <SplitButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" Opening="OnStartFlyoutOpening">
                    <StackPanel Spacing="8" Margin="2">
                        <TextBlock
                            Text="Started at"
                            FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:TimeOfDayBox
                                Text="{Binding StartTime}"
                                Width="96"
                                KeyDown="OnStartKeyDown" />
                            <Button
                                Classes="accent"
                                Content="Apply"
                                Click="OnStartApplyClick" />
                            <Button
                                ToolTip.Tip="Split the running entry"
                                Click="OnSplitClick">
                                <ui:FASymbolIcon Symbol="Cut" />
                            </Button>
                            <Button
                                ToolTip.Tip="Delete the running entry"
                                Click="OnDeleteClick">
                                <ui:FASymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </SplitButton.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="StopFilled" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" />
            </StackPanel>
        </SplitButton>
    </Grid>
</UserControl>
