<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:controls="clr-namespace:Werfer.Controls"
             x:Class="Werfer.Views.Timer.HistoryView"
             x:DataType="vm:TimerViewModel">
    <!-- The week's finished entries, grouped by day, then by project, task and description -->
    <DockPanel>
        <Border
            DockPanel.Dock="Top"
            Padding="12,6"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="This week" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding WeekTotal}"
                         FontWeight="SemiBold"
                         FontFeatures="+tnum" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- Empty state, docked above the list, which has nothing to show meanwhile -->
        <ui:FASymbolIcon
            DockPanel.Dock="Top"
            Margin="0,48"
            Symbol="CalendarEmpty"
            FontSize="40"
            Opacity="0.4"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsHistoryEmpty}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimeEntryDayViewModel">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <ui:FASymbolIcon Symbol="Calendar"
                                                     FontSize="14"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Total}"
                                           FontFeatures="+tnum"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimeEntryGroupViewModel">
                                        <controls:TimeEntryGroupCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
