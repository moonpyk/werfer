<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:controls="clr-namespace:Werfer.Controls"
             x:Class="Werfer.Views.Timer.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <UserControl.Resources>
        <!-- Logo shown when the history is empty: the white one on the dark theme, the black one on any other -->
        <ResourceDictionary>
            <!-- ReSharper disable Xaml.RedundantResource -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Bitmap x:Key="EmptyHistoryLogo">avares://Werfer/Assets/WerferWhite.png</Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <Bitmap x:Key="EmptyHistoryLogo">avares://Werfer/Assets/WerferBlack.png</Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- ReSharper restore Xaml.RedundantResource -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The week's finished entries, grouped by day, then by project, task and description -->
    <DockPanel>
        <Border
            DockPanel.Dock="Top"
            Padding="12,6"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="This week" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding WeekTotal}"
                         FontWeight="SemiBold"
                         FontFeatures="+tnum" />
                </TextBlock>
            </Grid>
        </Border>

        <!--
        The empty-state logo and the list share one cell, only one shows at a time, so the logo is centered in the whole
        area. As a DockPanel child that isn't the last one, it would be docked against the left edge instead
        -->
        <Panel>
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Stretch="None"
                Opacity="0.2"
                Margin="8"
                Source="{DynamicResource EmptyHistoryLogo}" />

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimeEntryDayViewModel">
                            <StackPanel>
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    Margin="12,10,12,6">
                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <ui:FASymbolIcon Symbol="Calendar"
                                                         FontSize="14"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Total}"
                                               FontFeatures="+tnum"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TimeEntryGroupViewModel">
                                            <controls:TimeEntryGroupCard />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
