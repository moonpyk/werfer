<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:ctl="clr-namespace:Werfer.Controls"
             x:Class="Werfer.Views.Edit.TimeEntryEditView"
             x:DataType="vm:TimeEntryEditViewModel">
    <!-- Layout: the day, start and end with the duration, the description, then the project and task -->
    <StackPanel Spacing="8">
        <!-- A group: how many entries, instead of the day and times each entry keeps -->
        <TextBlock Text="{Binding GroupTitle}" FontWeight="SemiBold" IsVisible="{Binding IsGroup}" />

        <CalendarDatePicker
            SelectedDate="{Binding Day}"
            HorizontalAlignment="Stretch"
            IsVisible="{Binding !IsGroup}" />

        <Grid ColumnDefinitions="96,Auto,96,*" IsVisible="{Binding !IsGroup}">
            <ctl:TimeOfDayBox Grid.Column="0" Text="{Binding Start}" />
            <ui:FASymbolIcon Grid.Column="1" Symbol="ChevronRight" FontSize="12" Margin="8,0" />
            <ctl:TimeOfDayBox Grid.Column="2" Text="{Binding End}" />
            <TextBlock
                Grid.Column="3"
                Text="{Binding Duration}"
                FontWeight="SemiBold"
                FontFeatures="+tnum"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>

        <ctl:ProjectTaskSelector
            AsyncPopulator="{Binding ProjectChoicesPopulator}"
            SelectedItem="{Binding SelectedChoice}" />

        <!-- Multiline like the timer bar's description, with the same \n line breaks, so the text compares equal to what Clockify sends back -->
        <TextBox
            Text="{Binding Description}"
            PlaceholderText="What did you work on?"
            AcceptsReturn="True"
            NewLine="&#10;"
            TextWrapping="Wrap"
            MinHeight="80"
            MaxHeight="140" />
    </StackPanel>
</UserControl>
