<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:cv="clr-namespace:Werfer.Converters"
             x:Class="Werfer.App"
             Name="Werfer"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- How a project and task suggestion looks: a colored dot, the project in its color, then the task. Used by the timer bar and the edit sheet -->
        <DataTemplate x:Key="ProjectTaskTemplate" x:DataType="vm:ProjectTaskViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold">
                    <TextBlock.Foreground>
                        <MultiBinding
                            Converter="{x:Static cv:ReadableTextBrushConverter.Instance}">
                            <Binding Path="Color" />
                            <Binding RelativeSource="{RelativeSource Self}" />
                            <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="{Binding Task.Name}" Opacity="0.8" />
            </StackPanel>
        </DataTemplate>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <!-- 
        No focus rectangle: it looks bad, and Avalonia's Control.OnGotFocus crashes when it adds one that is still 
        attached ("already has a visual parent AdornerLayer") 
        -->
        <Style Selector=":is(Control)">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
    </Application.Styles>
</Application>
