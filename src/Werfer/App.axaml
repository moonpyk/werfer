<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             x:Class="Werfer.App"
             x:DataType="vm:SettingsViewModel"
             Name="Werfer"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <!-- 
        No focus rectangle: it looks bad, and Avalonia's Control.OnGotFocus crashes when it adds one that is still 
        attached ("already has a visual parent AdornerLayer") (ref: https://github.com/AvaloniaUI/Avalonia/issues/22727)
        -->
        <Style Selector=":is(Control)">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
    </Application.Styles>

    <!-- Minimizing the main window hides it from the taskbar, this icon brings it back -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon 
                Icon="/Assets/Werfer.ico" 
                ToolTipText="Werfer"
                IsVisible="{Binding MinimizeToTray}"
                Clicked="OnTrayIconClick">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show" Click="OnTrayShowClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="OnTrayExitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
