<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:svc="clr-namespace:Werfer.Services"
                 xmlns:vm="clr-namespace:Werfer.ViewModels"
                 xmlns:views="clr-namespace:Werfer.Views"
                 xmlns:ctl="clr-namespace:Werfer.Controls"
                 x:Class="Werfer.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="avares://Werfer/Assets/Werfer.ico"
                 Title="Werfer"
                 Width="420"
                 Height="600"
                 MinHeight="300"
                 WindowStartupLocation="CenterScreen"
                 CanMaximize="False"
                 Topmost="{Binding Settings.Topmost}">
    <!-- Keyboard shortcuts. A shortcut does nothing while its command is null or can't execute (edit sheet open, another page shown...) -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Space" Command="{Binding Timer.ToggleCommand}" />
        <!-- Fetches the running entry and the week's history, they may have changed elsewhere -->
        <KeyBinding Gesture="F5" Command="{Binding Timer.RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ClearDescriptionCommand}" />
        <!-- "New": a blank, stopped timer -->
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ResetCommand}" />
        <!-- Closes the edit sheet, like its Cancel button. An open dropdown in the sheet gets Escape first -->
        <KeyBinding Gesture="Escape" Command="{Binding Timer.CloseEditorCommand}" />
        <!-- Ctrl+, : the usual settings shortcut (VS Code, Teams, macOS) -->
        <KeyBinding
            Gesture="Ctrl+OemComma"
            Command="{Binding NavigateCommand}"
            CommandParameter="{x:Static vm:AppPageEnum.Settings}" />
    </Window.KeyBindings>

    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            Padding="12,4"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    ToolTip.Tip="{Binding Status}"
                    VerticalAlignment="Center"
                    Text="{Binding Status}"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:FAProgressRing
                    Grid.Column="1"
                    Width="14"
                    Height="14"
                    Margin="8,0,0,0"
                    IsIndeterminate="True"
                    IsActive="{Binding IsAnyPageBusy}"
                    IsVisible="{Binding IsAnyPageBusy}" />
            </Grid>
        </Border>

        <!-- Declared after the status bar, so it sits right above it. Closing an info bar removes its message, so the same message can be shown again later -->
        <ItemsControl
            DockPanel.Dock="Bottom"
            Margin="8,0,8,4"
            ItemsSource="{Binding FlashMessages.Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="svc:FlashMessage">
                    <ui:FAInfoBar
                        Margin="0,4,0,0"
                        IsOpen="True"
                        Title="{Binding Title}"
                        Message="{Binding Message}"
                        Severity="{Binding Severity}"
                        Closed="OnFlashMessageClosed" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:FANavigationView
            x:Name="Navigation"
            PaneDisplayMode="Top"
            IsBackButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged"
            ItemInvoked="OnNavigationItemInvoked">
            <!--
            Both pages stay alive, the one not shown is only hidden. A page view removed from the window loses its data
            context on the way out, and the project box then cleared its pick in the view model
            -->
            <ui:FANavigationView.Content>
                <Panel>
                    <Panel
                        IsVisible="{Binding Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppPageEnum.Timer}}">
                        <views:TimerView DataContext="{Binding Timer}" />
                    </Panel>
                    <Panel
                        IsVisible="{Binding Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppPageEnum.Settings}}">
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Panel>
                </Panel>
            </ui:FANavigationView.Content>
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem
                    x:Name="TimerItem"
                    Content="Timer"
                    Tag="{x:Static vm:AppPageEnum.Timer}">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Clock" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>
            <ui:FANavigationView.FooterMenuItems>
                <!-- An action, not a page: clicking it doesn't change the selected item -->
                <ui:FANavigationViewItem
                    ToolTip.Tip="Fetch the running entry and the history from Clockify (F5)"
                    x:Name="RefreshItem"
                    SelectsOnInvoked="False"
                    IsVisible="{Binding ShowRefreshButton}"
                    IsEnabled="{Binding Timer.Player.ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Refresh" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <!--
                Menu of the pages that have no item of their own. More is selectable because FluentAvalonia undoes a
                selection made from code on a SelectsOnInvoked="False" item, so More could not stay selected while one
                of its pages is shown. If the menu closes without a pick, the selection goes back, see OnMoreMenuClosed
                -->
                <ui:FANavigationViewItem
                    x:Name="MoreItem"
                    ToolTip.Tip="More"
                    AutomationProperties.Name="More">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Closed="OnMoreMenuClosed">
                            <MenuItem
                                IsHitTestVisible="False"
                                Focusable="False"
                                IsVisible="{Binding DisplayCurrentUser}">
                                <MenuItem.Header>
                                    <!--
                                    Moved 28 px left, over the empty icon column every menu item has (16 px icon + 12 px
                                    gap), so the avatar lines up with the icons below. Also stretched 56 px right, over
                                    the shortcut column (24 px gap + "Ctrl+,"), empty on this line: the label column,
                                    shared with the Settings line, gets 56 px narrower, and the Settings shortcut moves
                                    closer to its label
                                    -->
                                    <ctl:AccountCard
                                        Margin="-28,0,-56,0"
                                        UserName="{Binding UserName}"
                                        Email="{Binding UserEmail}"
                                        Avatar="{Binding Avatar}" />
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator
                                IsVisible="{Binding DisplayCurrentUser}" />
                            <MenuItem
                                Header="Settings"
                                InputGesture="Ctrl+OemComma"
                                Tag="{x:Static vm:AppPageEnum.Settings}"
                                Click="OnMorePageClick">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Settings" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="More" />
                    </ui:FANavigationViewItem.IconSource>
                    <ui:FANavigationViewItem.InfoBadge>
                        <ui:FAInfoBadge
                            Classes="Icon Critical"
                            IsVisible="{Binding Settings.NeedsAttention}" />
                    </ui:FANavigationViewItem.InfoBadge>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.FooterMenuItems>
        </ui:FANavigationView>
    </DockPanel>
</wnd:FAAppWindow>
