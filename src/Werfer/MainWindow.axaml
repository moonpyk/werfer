<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:svc="clr-namespace:Werfer.Services"
                 xmlns:vm="clr-namespace:Werfer.ViewModels"
                 xmlns:views="clr-namespace:Werfer.Views"
                 xmlns:ctl="clr-namespace:Werfer.Controls"
                 x:Class="Werfer.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="avares://Werfer/Assets/Werfer.ico"
                 Title="Werfer"
                 Width="420"
                 Height="600"
                 MinHeight="300"
                 WindowStartupLocation="CenterScreen"
                 CanMaximize="False"
                 Topmost="{Binding ApplicationSettings.Topmost}">
    <!-- Page view models are mapped to their views here, no reflection-based ViewLocator (NativeAOT) -->
    <!-- Shortcuts; their conditions (no edit sheet open, timer page, ...) are the commands' CanExecute -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Space" Command="{Binding Timer.ToggleCommand}" />
        <!-- Fetches the running entry and the week's history, they may have changed elsewhere -->
        <KeyBinding Gesture="F5" Command="{Binding Timer.RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ClearDescriptionCommand}" />
        <!-- "New": a blank, stopped timer -->
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ResetCommand}" />
        <!-- Closes the edit sheet, like its Cancel button; an open dropdown inside it takes Escape first -->
        <KeyBinding Gesture="Escape" Command="{Binding Timer.CloseEditorCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:TimerViewModel">
            <views:TimerView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            Padding="12,4"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    ToolTip.Tip="{Binding Status}"
                    VerticalAlignment="Center"
                    Text="{Binding Status}"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:FAProgressRing
                    Grid.Column="1"
                    Width="14"
                    Height="14"
                    Margin="8,0,0,0"
                    IsIndeterminate="True"
                    IsActive="{Binding IsAnyPageBusy}"
                    IsVisible="{Binding IsAnyPageBusy}" />
            </Grid>
        </Border>

        <!-- Docked after the status bar, so stacked right above it. Closing an info bar removes its message, the same message can then be pushed again -->
        <ItemsControl
            DockPanel.Dock="Bottom"
            Margin="8,0,8,4"
            ItemsSource="{Binding FlashMessages.Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="svc:FlashMessage">
                    <ui:FAInfoBar
                        Margin="0,4,0,0"
                        IsOpen="True"
                        Title="{Binding Title}"
                        Message="{Binding Message}"
                        Severity="{Binding Severity}"
                        Closed="OnFlashMessageClosed" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:FANavigationView
            x:Name="Navigation"
            PaneDisplayMode="Top"
            IsBackButtonVisible="False"
            IsSettingsVisible="False"
            Content="{Binding CurrentPage}"
            SelectionChanged="OnNavigationSelectionChanged"
            ItemInvoked="OnNavigationItemInvoked">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem
                    x:Name="TimerItem"
                    Content="Timer"
                    Tag="{x:Static vm:AppPageEnum.Timer}">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Clock" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>
            <ui:FANavigationView.FooterMenuItems>
                <!-- Action, not a page: invoking it doesn't change the selection -->
                <ui:FANavigationViewItem
                    ToolTip.Tip="Fetch the running entry and the history from Clockify (F5)"
                    x:Name="RefreshItem"
                    SelectsOnInvoked="False"
                    IsVisible="{Binding ShowRefreshButton}"
                    IsEnabled="{Binding Timer.Player.ProjectChoices, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Refresh" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <!--
                Menu of the pages without an item of their own. Selectable: FluentAvalonia reverts a selection from code
                of a SelectsOnInvoked="False" item, More couldn't stay selected while on one of its pages. Its selection
                is undone if the menu closes without a pick, see OnMoreMenuClosed
                -->
                <ui:FANavigationViewItem
                    x:Name="MoreItem"
                    ToolTip.Tip="More"
                    AutomationProperties.Name="More">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Closed="OnMoreMenuClosed">
                            <MenuItem
                                IsHitTestVisible="False"
                                Focusable="False">
                                <MenuItem.Header>
                                    <!-- 
                                    Pulled left over the empty icon column every menu item has (16 px icon + 12 px gap),
                                    so the avatar lines up with the icons below 
                                    -->
                                    <ctl:AccountCard
                                        Margin="-28,0,0,0"
                                        UserName="{Binding UserName}"
                                        Email="{Binding UserEmail}"
                                        Avatar="{Binding Avatar}" />
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="Settings"
                                Tag="{x:Static vm:AppPageEnum.Settings}"
                                Click="OnMorePageClick">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Settings" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="More" />
                    </ui:FANavigationViewItem.IconSource>
                    <ui:FANavigationViewItem.InfoBadge>
                        <ui:FAInfoBadge
                            Classes="Icon Critical"
                            IsVisible="{Binding Settings.NeedsAttention}" />
                    </ui:FANavigationViewItem.InfoBadge>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.FooterMenuItems>
        </ui:FANavigationView>
    </DockPanel>
</wnd:FAAppWindow>
