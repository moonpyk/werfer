<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Werfer.ViewModels"
             xmlns:converters="clr-namespace:Werfer.Converters"
             x:Class="Werfer.Controls.TimeEntryGroupCard"
             x:DataType="vm:TimeEntryGroupViewModel">
    <UserControl.Resources>
        <!-- Entry menu, opened by the three dots and by a right click on the card or line; one instance per use -->
        <MenuFlyout x:Key="EntryMenu" x:Shared="False">
            <MenuItem x:DataType="vm:TimeEntryItemViewModelBase" Header="Delete" Command="{Binding DeleteCommand}">
                <MenuItem.Icon>
                    <ui:FASymbolIcon Symbol="Delete" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuFlyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- History cards -->
        <Style Selector="Border.entryCard">
            <Setter Property="Margin" Value="8,0,8,6" />
            <Setter Property="Padding" Value="12,8,4,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- An entry of an expanded group, a darker card inside the group's -->
        <Style Selector="Border.entryLine">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,4,4,4" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <!-- Slight highlight on hover, the theme's own hover fills -->
        <Style Selector="Border.entryCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.entryLine:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <!-- Square play button, the theme's corner radius like the three dots, hidden until its card or line is hovered; Opacity rather than IsVisible keeps its room,
             so the layout doesn't jump. Also shown when tabbed to: :focus-visible, not the card's :focus-within, which
             the three dots button keeps after a click and its menu closed. The group's is matched as a direct child,
             hovering the group card mustn't show the play buttons of all its lines -->
        <Style Selector="Border.entryCard Button.continue">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style
            Selector="Border.entryCard:pointerover > Grid > Button.continue,
                         Border.entryLine:pointerover Button.continue,
                         Button.continue:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Three dots, flat until hovered -->
        <Style Selector="Button.more">
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Border Classes="entryCard" ContextFlyout="{StaticResource EntryMenu}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              RowDefinitions="Auto,Auto">
            <!-- Entry count, toggles the entries of the group -->
            <ToggleButton
                x:Name="CountToggle"
                Grid.Column="0"
                Grid.Row="0"
                ToolTip.Tip="Show the entries"
                Margin="0,0,8,0"
                Padding="6,0"
                MinWidth="24"
                VerticalAlignment="Center"
                Content="{Binding Count}"
                IsVisible="{Binding IsMultiple}" />
            <StackPanel Grid.Column="1" Grid.Row="0">
                <TextBlock
                    Text="{Binding DisplayDescription}"
                    Opacity="{Binding DescriptionOpacity}"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Description}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding Brush}"
                        IsVisible="{Binding Choice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Foreground>
                            <MultiBinding
                                Converter="{x:Static converters:ReadableTextBrushConverter.Instance}">
                                <Binding Path="Color" />
                                <Binding RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualThemeVariant"
                                         RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding TaskName}" FontSize="12"
                               Opacity="0.8"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ClientName}" FontSize="12"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ClientName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
            <!-- Same project, task and description, as a new entry; only shown on hover, see entryCard -->
            <Button
                Grid.Column="2"
                Grid.Row="0"
                ToolTip.Tip="Continue"
                Classes="accent continue"
                Command="{Binding ContinueCommand}">
                <ui:FASymbolIcon Symbol="PlayFilled" FontSize="12" />
            </Button>
            <StackPanel Grid.Column="3" Grid.Row="0" Margin="8,0,4,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Duration}"
                           FontWeight="SemiBold"
                           FontFeatures="+tnum"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Range}"
                           FontSize="12"
                           FontFeatures="+tnum"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button
                Grid.Row="0"
                Grid.Column="4"
                ToolTip.Tip="More"
                Classes="more"
                Flyout="{StaticResource EntryMenu}">
                <ui:FASymbolIcon Symbol="MoreVertical" FontSize="16" />
            </Button>

            <!-- One sub-card per entry of the expanded group -->
            <ItemsControl
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Grid.Row="1"
                Margin="0,8,8,0"
                ItemsSource="{Binding Entries}"
                IsVisible="{Binding #CountToggle.IsChecked}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        x:DataType="vm:TimeEntryLineViewModel">
                        <Border Classes="entryLine" ContextFlyout="{StaticResource EntryMenu}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Range}"
                                           FontFeatures="+tnum"
                                           VerticalAlignment="Center" />
                                <!-- Continues the group: its entries share project, task and description -->
                                <Button
                                    Grid.Column="1"
                                    ToolTip.Tip="Continue"
                                    Classes="accent continue"
                                    Command="{Binding Group.ContinueCommand}">
                                    <ui:FASymbolIcon Symbol="PlayFilled"
                                                     FontSize="12" />
                                </Button>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,4,0"
                                           Text="{Binding Duration}"
                                           FontFeatures="+tnum"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="3"
                                        ToolTip.Tip="More"
                                        Classes="more"
                                        Flyout="{StaticResource EntryMenu}">
                                    <ui:FASymbolIcon Symbol="MoreVertical"
                                                     FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
