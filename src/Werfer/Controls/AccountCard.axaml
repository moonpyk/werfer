<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="Werfer.Controls.AccountCard">
    <!-- 
    Avatar on the left, name above the email on the right. The texts and the picture are set in code, see
    OnPropertyChanged 
    -->
    <UserControl.Resources>
        <system:Double x:Key="AvatarSize">32</system:Double>
        <CornerRadius x:Key="AvatarCornerRadius">
            16<!-- Half the avatar size to get a circle --></CornerRadius>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- The profile picture in a circle, or the Contact symbol when there is none -->
        <Border
            Width="{StaticResource AvatarSize}"
            Height="{StaticResource AvatarSize}"
            CornerRadius="{StaticResource AvatarCornerRadius}"
            ClipToBounds="True"
            VerticalAlignment="Center"
            Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Panel>
                <ui:FASymbolIcon x:Name="ContactIcon" Symbol="Contact" FontSize="16" />
                <Image
                    x:Name="AvatarImage"
                    Stretch="UniformToFill" />
            </Panel>
        </Border>
        <!-- 
        Max width: the card sets the width of the More menu, and a long email pushed the shortcuts far to the right 
        -->
        <StackPanel VerticalAlignment="Center" MaxWidth="160">
            <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="EmailText"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
