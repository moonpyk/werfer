<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14"/>
        <PackageReference Condition="$(Configuration) == 'Debug'" Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Logging.TraceSource" Version="10.0.14"/>
        <PackageReference Include="Refit" Version="8.0.0"/>
        <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0"/>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\README.md">
            <Link>README.md</Link>
        </Content>
    </ItemGroup>

</Project>
